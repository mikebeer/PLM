#!/bin/sh
# plmc - compile and run a PL/M-80 program
#
#   plmc program.plm            compile and run
#   plmc -c program.plm         compile only (writes program.rxas and program.rxbin)
#
# Environment: CREXX_BIN = directory with rxas and rxvm (default: found via PATH)
HERE=$(cd "$(dirname "$0")" && pwd)
BIN=${CREXX_BIN:-$(dirname "$(command -v rxvm)")}
ONLY=0
if [ "$1" = "-c" ]; then ONLY=1; shift; fi
if [ -z "$1" ] || [ ! -f "$1" ]; then
  echo "usage: plmc [-c] program.plm" >&2
  exit 2
fi
SRC=$1; shift
if [ ! -f "$HERE/build/plm.rxbin" ] || [ ! -f "$HERE/build/plmrt.rxbin" ]; then
  echo "plmc: run 'make' first" >&2
  exit 2
fi
if [ $ONLY = 1 ]; then
  STEM=${SRC%.*}
  "$BIN/rxvm" "$HERE/build/plm.rxbin" -a "$SRC" "$STEM.rxas" || exit 1
  exec "$BIN/rxas" "$STEM"
fi
# compile and run in a scratch directory, so that no files are left behind
TMP=$(mktemp -d "${TMPDIR:-/tmp}/plmc.XXXXXX")
trap 'rm -rf "$TMP"' EXIT
"$BIN/rxvm" "$HERE/build/plm.rxbin" -a "$SRC" "$TMP/prog.rxas" || exit 1
(cd "$TMP" && "$BIN/rxas" prog) || exit 1
"$BIN/rxvm" "$TMP/prog.rxbin" "$HERE/build/plmrt.rxbin" -a "$@"
