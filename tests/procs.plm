/* procedures, functions and recursion */
PROCS: DO;

DECLARE I BYTE;

SQUARE: PROCEDURE (X) ADDRESS;
   DECLARE X BYTE;
   RETURN DOUBLE(X) * X;
END SQUARE;

MAX: PROCEDURE (A, B) ADDRESS;
   DECLARE (A, B) ADDRESS;
   IF A > B THEN RETURN A;
   RETURN B;
END MAX;

COUNT: PROCEDURE BYTE;
   DECLARE N BYTE INITIAL(0);
   N = N + 1;
   RETURN N;
END COUNT;

FACT: PROCEDURE (N) ADDRESS REENTRANT;
   DECLARE N BYTE;
   IF N <= 1 THEN RETURN 1;
   RETURN N * FACT(N - 1);
END FACT;

FIB: PROCEDURE (N) ADDRESS REENTRANT;
   DECLARE N BYTE;
   IF N < 2 THEN RETURN N;
   RETURN FIB(N - 1) + FIB(N - 2);
END FIB;

HANOI: PROCEDURE (N, FROM, TOP, VIA) REENTRANT;
   DECLARE (N, FROM, TOP, VIA) BYTE;
   IF N = 0 THEN RETURN;
   CALL HANOI(N - 1, FROM, VIA, TOP);
   CALL CO(FROM); CALL CO('>'); CALL CO(TOP); CALL CO(' ');
   CALL HANOI(N - 1, VIA, TOP, FROM);
END HANOI;

PRINTNUM: PROCEDURE (N);
   DECLARE N ADDRESS;
   CALL PRNUM(N);
   CALL CRLF;
END PRINTNUM;

CALL PRINTNUM(SQUARE(200));         /* 40000 */
CALL PRINTNUM(MAX(7, 300));         /* 300 */
CALL PRINTNUM(MAX(SQUARE(3), 5));   /* 9 */
CALL PRINTNUM(COUNT + COUNT + COUNT);  /* 1 + 2 + 3 = 6 */
DO I = 0 TO 8;
   CALL PRNUM(FACT(I)); CALL CO(' ');
END;
CALL CRLF;                          /* 1 1 2 6 24 120 720 5040 40320 */
CALL PRINTNUM(FIB(15));             /* 610 */
CALL HANOI(3, 'A', 'C', 'B');
CALL CRLF;                          /* A>C A>B C>B A>C B>A B>C A>C */

END PROCS;
