/* Recursion: REENTRANT procedures save their variables around each call */
RECUR: DO;

DECLARE I BYTE;

FACT: PROCEDURE (N) ADDRESS REENTRANT;
   DECLARE N BYTE;
   IF N <= 1 THEN RETURN 1;
   RETURN N * FACT(N - 1);
END FACT;

FIB: PROCEDURE (N) ADDRESS REENTRANT;
   DECLARE N BYTE;
   IF N < 2 THEN RETURN N;
   RETURN FIB(N - 1) + FIB(N - 2);
END FIB;

HANOI: PROCEDURE (N, FROM, TOP, VIA) REENTRANT;
   DECLARE (N, FROM, TOP, VIA) BYTE;
   IF N = 0 THEN RETURN;
   CALL HANOI(N - 1, FROM, VIA, TOP);
   CALL CO(FROM); CALL CO('>'); CALL CO(TOP); CALL CO(' ');
   CALL HANOI(N - 1, VIA, TOP, FROM);
END HANOI;

DO I = 1 TO 8;
   CALL PRNUM(FACT(I));
   CALL CO(' ');
END;
CALL CRLF;
DO I = 10 TO 20 BY 2;
   CALL PRNUM(FIB(I));
   CALL CO(' ');
END;
CALL CRLF;
CALL HANOI(4, 'A', 'C', 'B');
CALL CRLF;

END RECUR;
