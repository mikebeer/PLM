/* procedures: recursion, results, parameters */
T2: DO;
DECLARE (N, R) ADDRESS;
DECLARE CNT BYTE;
FACT: PROCEDURE (N) ADDRESS REENTRANT;
  DECLARE N ADDRESS;
  IF N <= 1 THEN RETURN 1;
  RETURN N * FACT(N - 1);
END FACT;
FIB: PROCEDURE (N) ADDRESS REENTRANT;
  DECLARE N ADDRESS;
  IF N < 2 THEN RETURN N;
  RETURN FIB(N - 1) + FIB(N - 2);
END FIB;
GCD: PROCEDURE (A, B) ADDRESS;
  DECLARE (A, B) ADDRESS;
  DECLARE T ADDRESS;
  DO WHILE B <> 0;
    T = A MOD B; A = B; B = T;
  END;
  RETURN A;
END GCD;
HANOI: PROCEDURE (N, F, T, V) REENTRANT;
  DECLARE (N, F, T, V) BYTE;
  IF N = 0 THEN RETURN;
  CALL HANOI(N - 1, F, V, T);
  CNT = CNT + 1;
  CALL HANOI(N - 1, V, T, F);
END HANOI;
NOARGS: PROCEDURE;
  CALL CO('!');
END NOARGS;
BYTEF: PROCEDURE (X) BYTE;
  DECLARE X ADDRESS;
  RETURN X;
END BYTEF;
ACK: PROCEDURE (M, N) ADDRESS REENTRANT;
  DECLARE (M, N) ADDRESS;
  IF M = 0 THEN RETURN N + 1;
  IF N = 0 THEN RETURN ACK(M - 1, 1);
  RETURN ACK(M - 1, ACK(M, N - 1));
END ACK;
DO N = 0 TO 9;
  CALL PRNUM(FACT(N)); CALL CO(' ');
END;
CALL CRLF;
CALL PRNUM(FIB(20)); CALL CRLF;
CALL PRNUM(GCD(1071, 462)); CALL CRLF;
CALL HANOI(8, 1, 3, 2); CALL PRNUM(CNT); CALL CRLF;
CALL NOARGS; CALL NOARGS(); CALL CRLF;
CALL PRNUM(BYTEF(1000)); CALL CRLF;
CALL PRNUM(ACK(2, 3)); CALL CRLF;
CALL PRNUM(FACT(5) + FACT(3) * FIB(10)); CALL CRLF;
END T2;
