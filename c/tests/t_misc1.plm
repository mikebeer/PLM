/* arrays, structures, based, loops, shifts and memory */
T1: DO;
DECLARE (I, J, K) BYTE, (X, Y) ADDRESS;
DECLARE TAB(6) ADDRESS INITIAL(1, 300, 65535 MOD 1000, 'A', 'AB');
DECLARE MSG(*) BYTE DATA('Hi there', 0DH, 0AH, '$');
DECLARE W STRUCTURE (A BYTE, B ADDRESS, C(3) BYTE, D(2) ADDRESS);
DECLARE PTR ADDRESS, BB BASED PTR BYTE, BA(4) BASED PTR ADDRESS;
DECLARE FIXED(3) BYTE AT (0F000H);
I = 250;
DO J = 0 TO 255;
  K = K + 1;
END;
CALL PRNUM(K); CALL CRLF;
DO J = 255 TO 255; CALL PRNUM(J); END; CALL CRLF;
DO X = 65530 TO 65535; CALL PRNUM(X); CALL CO(' '); END; CALL CRLF;
DO J = 10 TO 1; CALL CO('x'); END;
DO J = 1 TO 10 BY 4; CALL PRNUM(J); CALL CO(' '); END; CALL CRLF;
K = 3;
DO J = 0 TO 20 BY K; CALL PRNUM(J); CALL CO(' '); END; CALL CRLF;
DO J = 0 TO 5 BY 0 + 1; CALL PRNUM(J); END; CALL CRLF;
DO X = 1 TO 3; DO Y = 1 TO 3; CALL PRNUM(X * Y); END; END; CALL CRLF;
CALL PRINT(.MSG);
CALL PRINT(.'hello$');
CALL PRNUM(TAB(1)); CALL CO(' '); CALL PRNUM(TAB(2)); CALL CO(' ');
CALL PRNUM(TAB(3)); CALL CO(' '); CALL PRNUM(TAB(4)); CALL CRLF;
CALL PRNUM(LENGTH(TAB)); CALL PRNUM(LAST(TAB)); CALL PRNUM(SIZE(TAB));
CALL PRNUM(SIZE(W)); CALL PRNUM(LENGTH(W.C));
CALL PRNUM(SIZE(W.D)); CALL CRLF;
W.A = 255; W.B = 1234; W.C(0) = 1; W.C(2) = 3; W.D(1) = 777;
CALL PRNUM(W.A + W.B + W.C(2) + W.D(1)); CALL CRLF;
PTR = .W.B;
CALL PRNUM(BA(0)); CALL CRLF;
PTR = .TAB;
CALL PRNUM(BA(1)); CALL CO(' '); CALL PRNUM(BA(2)); CALL CRLF;
BB = 66; CALL PRNUM(TAB(0)); CALL CRLF;
FIXED(0) = 5; FIXED(2) = 9;
CALL PRNUM(MEMORY(0F000H) + MEMORY(0F002H)); CALL CRLF;
CALL PRHEX(.FIXED); CALL CRLF;
MEMORY(100H) = 77; CALL PRNUM(MEMORY(256)); CALL CRLF;
CALL MOVE(8, .MSG, .MSG + 3);
CALL PRINT(.MSG); CALL CRLF;
CALL MOVE(4, .TAB, 0F100H);
CALL PRNUM(MEMORY(0F102H)); CALL CRLF;
CALL PRNUM(.W - .FIXED); CALL CRLF;
CALL PRNUM(DOUBLE(200) * 2); CALL CRLF;
CALL PRNUM(200 * 2); CALL CRLF;
I = 200; CALL PRNUM(I * 2); CALL CRLF;
CALL PRNUM(HIGH(1234H)); CALL PRNUM(LOW(1234H)); CALL CRLF;
GO TO FWD;
CALL PRNUM(999);
FWD: CALL PRNUM(1); CALL CRLF;
LOOP: I = I + 1;
IF I < 5 THEN GOTO LOOP;
CALL PRNUM(I); CALL CRLF;
I = 0;
DO WHILE I < 5; I = I + 1; IF I = 3 THEN CALL PRNUM(I); END;
CALL CRLF;
DO CASE I - 3;
  CALL PRNUM(10);
  CALL PRNUM(11);
  CALL PRNUM(12);
END;
DO CASE 7; CALL PRNUM(1); CALL PRNUM(2); END;
CALL CRLF;
CALL PRNUM(NOT 0); CALL PRNUM(NOT 255);
CALL PRNUM(NOT (1 = 1)); CALL PRNUM(NOT (I = 5));
CALL CRLF;
X = 1000; I = 7;
CALL PRNUM(-I); CALL CO(' '); CALL PRNUM(-X); CALL CO(' ');
CALL PRNUM(-5); CALL CO(' ');
CALL PRNUM(X - 2000); CALL CO(' '); CALL PRNUM(I - 10); CALL CRLF;
CALL PRNUM(SHL(1, 15)); CALL CO(' '); CALL PRNUM(SHL(I, 6));
CALL CO(' ');
CALL PRNUM(SHR(X, 3)); CALL CO(' '); CALL PRNUM(ROL(I, 7));
CALL CO(' ');
CALL PRNUM(ROR(I, 1)); CALL CO(' '); CALL PRNUM(ROL(1234H, 4));
CALL CO(' ');
CALL PRNUM(ROR(X, 20)); CALL CRLF;
CALL PRNUM(SHL(I, I)); CALL CO(' '); CALL PRNUM(ROL(X, I));
CALL CO(' ');
CALL PRNUM(ROR(I, I)); CALL CRLF;
X = 64; Y = 65; I = 200;
CALL PRNUM(SHL(1, X)); CALL CO(' '); CALL PRNUM(SHL(1, Y));
CALL CO(' '); CALL PRNUM(SHR(65535, I)); CALL CO(' ');
CALL PRNUM(SHL(1, 65535)); CALL CRLF;
END T1;
