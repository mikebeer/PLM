T8: DO;
DECLARE C BYTE, N ADDRESS;
DO N = 1 TO 12;
  C = CI;
  CALL PRNUM(C); CALL CO(' ');
END;
CALL CRLF;
CALL PRHEX(255, 1); CALL CRLF;
CALL PRHEX(255, 0); CALL CRLF;
CALL PRHEX(10, 6); CALL CRLF;
CALL PRHEX(65535); CALL CRLF;
CALL PRHEX(1); CALL CRLF;
CALL PRHEX(300); CALL CRLF;
CALL PRHEX(171, 3); CALL CRLF;
CALL CO(233); CALL CO(128); CALL CO(255); CALL CO(65); CALL CO(7);
CALL CO(0); CALL CO(13); CALL CO(9); CALL CO(10); CALL CO(66);
CALL PRNUM(65535 + 3); CALL CO(33);
END T8;
